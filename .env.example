# ============================================
# Job Ingestion Engine — Environment Variables
# ============================================
# Copy this file to .env and fill in values

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017/job-ingestion

# --- Redis (for BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- API Server ---
API_PORT=3000

# --- Sandbox Source Server ---
SANDBOX_PORT=3001

# --- Proxy Pool (stub — use comma-separated proxy URLs) ---
# PROXY_URLS=http://proxy1:8080,http://proxy2:8080

# --- Ingestion Config ---
# Default tier: 0 = API, 1 = static HTML, 2 = headless browser
DEFAULT_TIER=0
# Max concurrent jobs per domain
MAX_CONCURRENCY_PER_DOMAIN=2
# Request delay range in ms (jittered between min and max)
REQUEST_DELAY_MIN_MS=3000
REQUEST_DELAY_MAX_MS=9000

# --- Circuit Breaker ---
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000

# --- Dashboard ---
DASHBOARD_PORT=5173

# --- Node Environment ---
NODE_ENV=development
